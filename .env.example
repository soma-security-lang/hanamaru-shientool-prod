NODE_ENV=production
DATABASE_URL=
DATABASE_SSL=disable
DATABASE_CONTEXT_ROLE=
DATABASE_SYSTEM_ROLE=
PROVIDER_MODE=local-connected
ALLOW_DEV_AUTH=false
API_HOST=127.0.0.1
API_PORT=3200
WORKER_HOST=127.0.0.1
WORKER_PORT=3300
LOCAL_POSTGRES_PORT=54329
LOCAL_WEB_PORT=3100
LOCAL_API_PORT=3200
LOCAL_WORKER_PORT=3300
LOCAL_STORAGE_DIR=
LOCAL_POSTGRES_PASSWORD=
CORS_ORIGINS=http://127.0.0.1:3100
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3200/api/v1
NEXT_PUBLIC_IDENTITY_PLATFORM_API_KEY=
NEXT_PUBLIC_IDENTITY_PLATFORM_AUTH_DOMAIN=monocle-503402.firebaseapp.com
NEXT_PUBLIC_IDENTITY_PLATFORM_PROJECT_ID=monocle-503402
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=
NEXT_PUBLIC_PROTOTYPE_MODE=disabled
CONTENT_IMPORT_ORGANIZATION_ID=
CONTENT_IMPORT_OWNER_MEMBERSHIP_ID=
# Production bootstrap must explicitly choose true or false. Local development
# seeds this flag true so the limited-operation PoC flows remain testable.
PILOT_CONTENT_AI_ENABLED=

# Production DB bootstrap. The command is dry-run unless --apply is supplied.
# Keep the real manager email only in a chmod 600 environment file. The CLI
# stores its SHA-256 and a fixed redacted mask; it never prints the address.
BOOTSTRAP_ORGANIZATION_ID=
BOOTSTRAP_ORGANIZATION_KEY=
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_BRANCH_ID=
BOOTSTRAP_BRANCH_KEY=
BOOTSTRAP_BRANCH_NAME=
BOOTSTRAP_INITIAL_MANAGER_USER_ID=
BOOTSTRAP_INITIAL_MANAGER_MEMBERSHIP_ID=
BOOTSTRAP_INITIAL_MANAGER_EMAIL=
BOOTSTRAP_INITIAL_MANAGER_DISPLAY_NAME=
BOOTSTRAP_VERTEX_AI_MODEL=gemini-2.5-flash
BOOTSTRAP_RETENTION_PDF_DAYS=
BOOTSTRAP_RETENTION_AUDIO_DAYS=
BOOTSTRAP_RETENTION_VIDEO_DAYS=
BOOTSTRAP_RETENTION_TRANSCRIPT_DAYS=
BOOTSTRAP_RETENTION_REVIEW_DAYS=
BOOTSTRAP_RETENTION_AUDIT_DAYS=

# Google Identity Platform. The Web obtains the ID token; the API verifies the
# securetoken issuer, audience and JWKS for this fixed project.
IDENTITY_PLATFORM_PROJECT_ID=monocle-503402
# The seed hashes this address to bind the approved local Google account.
# Keep the real value only in chmod 600 .env.local, never in Git or chat.
LOCAL_ALLOWED_GOOGLE_EMAIL=
LOCAL_ALLOWED_ASSESSOR_GOOGLE_EMAIL=
LOCAL_ALLOWED_SYSTEM_ADMIN_EMAIL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
TOKEN_ENCRYPTION_KEY_B64=
TOKEN_ENCRYPTION_KEY_VERSION=

# Google Cloud Application Default Credentials (ADC) are used. The path is
# optional when gcloud's standard ADC file is available.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=monocle-503402
GCP_LOCATION=asia-northeast1
GCS_PRIVATE_BUCKET=
STT_INPUT_BUCKET=
SPEECH_LOCATION=us
SPEECH_MODEL=chirp_3
CLOUD_TASKS_QUEUE=
WORKER_TASK_URL=
TASK_SERVICE_ACCOUNT=
VERTEX_LOCATION=asia-northeast1
VERTEX_AI_MODEL=gemini-2.5-flash
# Legacy server-side Drive import adapter. The normal Web path uses the
# Identity Platform Google credential and streams the selected file directly
# into the protected upload boundary without persisting a Google access token.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# GIS authorization-code popup mode requires the calling page origin here.
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:3100

# Real Google API E2E. Only approved anonymous test data may be referenced.
LIVE_E2E_DATA_CLASSIFICATION=
LIVE_E2E_PDF_PATH=
LIVE_E2E_AUDIO_PATH=
LIVE_E2E_GOOGLE_DRIVE_FILE_ID=
LIVE_E2E_GOOGLE_DRIVE_REFRESH_TOKEN=
LIVE_E2E_GOOGLE_ID_TOKEN=
LIVE_E2E_ASSESSOR_GOOGLE_ID_TOKEN=
