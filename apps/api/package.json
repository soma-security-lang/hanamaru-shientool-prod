    "@hanamaru/contracts": "workspace:*",
    "@hanamaru/database": "workspace:*",
    "@hanamaru/market-price": "workspace:*",
    "@hanamaru/platform": "workspace:*",
    "fastify": "^5.12.7",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.0"
  }
