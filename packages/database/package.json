{
  "name": "@hanamaru/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types":"./src/index.ts", "default":"./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/migrations && cp -R migrations/. dist/migrations/",
    "migrate": "tsx src/cli-migrate.ts",
    "seed:dev": "tsx src/cli-seed.ts",
    "bootstrap:production": "tsx src/cli-bootstrap-production.ts",
    "roles:provision:production": "tsx src/cli-provision-runtime-roles.ts",
    "content:import": "tsx src/cli-import-content.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run src/*.integration.test.ts --no-file-parallelism --maxWorkers=1"
  },
  "dependencies": {
    "@hanamaru/contracts": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
